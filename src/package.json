{
  "name": "dsh-harnessams",
  "version": "0.1.0",
  "description": "HarnessAMS top-level plugin: console and orchestration (server health checks, disk usage/capacity, workspace directory management)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
