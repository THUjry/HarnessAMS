{
  "name": "dsh-harnessams",
  "version": "0.1.0",
  "description": "HarnessAMS top-level plugin: three-tier UI (global console page over /harnessams APIs, project = DSH workspace, per-project task sidebar) plus remote projects over dsh-remote, per-project health checks, disk usage, digital assets, the generic remote batch channel (batch_submit/batch_poll/batch_fetch) and the simulator-agnostic analysis tools (collect/progress/report/trash)",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "server/",
    "tools/",
    "tool.js",
    "py.js",
    "bsub.js",
    "remote.js",
    "trash.js",
    "cordis.patch.yml",
    "selfcheck/",
    "assets/",
    "locale/",
    "scripts/",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THUjry/HarnessAMS.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-webserver": "0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2"
  }
}
