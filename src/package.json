{
  "name": "dsh-harnessams",
  "version": "0.1.0",
  "description": "HarnessAMS top-level plugin: three-tier UI (global console page over /harnessams APIs, project = DSH workspace, per-session sidebar) plus remote machines over @linxin666/dsh-ssh, the project self-check, disk usage, digital assets, the managed scan channel (batch_submit with its local/ssh/lsf schedulers per cluster_env, batch_poll monitoring with terminal auto-fetch) and the simulator-agnostic report/ops tools (gen_sweep_report/safe_trash)",
  "type": "module",
  "icon": "icon.png",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client/",
    "server/",
    "tools/",
    "lib/",
    "channel/",
    "core/",
    "tool.js",
    "skills.js",
    "skills/",
    "icon.png",
    "cordis.patch.yml",
    "selfcheck/",
    "assets/",
    "locale/",
    "scripts/",
    "!**/__pycache__",
    "!**/*.pyc"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "engines": {
    "dsh": "0.2.2-rc.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/THUjry/HarnessAMS.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.2-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "jsdom": "^31.0.1"
  }
}
