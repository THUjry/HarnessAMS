    "cordis.patch.yml",
    "assets/",
    "scripts/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": "0.2.1-rc.2"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-host-webserver": ">=0.0.1-rc.1"
  },
